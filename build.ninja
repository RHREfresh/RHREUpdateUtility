# Ninja build for RHREUpdate

pool link_pool
  depth = 1

rule cc
  deps = gcc
  depfile = $out.d
  command = x86_64-w64-mingw32-g++ -MMD -MF $out.d $cflags -c $in -o $out

rule link
  pool = link_pool
  command = x86_64-w64-mingw32-g++ $ldflags $in -o $out -static

outdir = build
cflags = -std=c++20 -O3 -Isrc
ldflags = -lm

build $outdir/main.o: cc src/main.cpp
build $outdir/Error.o: cc src/Error.cpp

build $outdir/RHREExeUpdateHelper: link $
    $outdir/main.o $
    $outdir/Error.o 
